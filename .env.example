APP_NAME="AI Database Assistant"
ENV="development"
PORT=8000

# PostgreSQL Configuration (Option A: Single DATABASE_URL string)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/enterprise_db"

# PostgreSQL Configuration (Option B: Individual fields)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="enterprise_db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# LLM Keys (OpenAI or Google Gemini)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
ENABLE_SEMANTIC_CACHE=true
APP_API_KEY=
MAX_PROMPT_LENGTH=2000